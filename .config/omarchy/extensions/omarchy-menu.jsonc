{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Name of a shell-defined runtime row source (e.g. "fonts").
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // provider can only reference row sources the shell already defines (the
  // providers map in Menu.qml). Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},
  // Top bar and bottom band: black, or clear over the wallpaper (omarchy-bands).
  "trigger.toggle.bands-clear": {"icon":"󰹑","label":"Clear Bars","when":"[[ $(omarchy-bands) == black ]]","action":"omarchy-bands clear"},
  "trigger.toggle.bands-black": {"icon":"󰹑","label":"Black Bars","when":"[[ $(omarchy-bands) == clear ]]","action":"omarchy-bands black"},
  // Cmd+K menus (omarchy-pane-menu): one per app ("app-<class>"; "firefox" alone collides with the Firefox app entry), over that app's pane, plus
  // "pane" for apps without one. Hidden from Spotlight's own list and search.
  // App rows hand focus back and press the app's shortcut.
  "pane": {"icon":"󰕰","label":"Pane"},
  "pane.left": {"icon":"󰯌","label":"Left Half","description":"pane snap move","action":"omarchy-snap left"},
  "pane.right": {"icon":"󰯋","label":"Right Half","description":"pane snap move","action":"omarchy-snap right"},
  "pane.full": {"icon":"󰊓","label":"Full Screen","description":"pane maximize","action":"omarchy-snap full"},
  "pane.display": {"icon":"󰍹","label":"Move to Other Display","description":"pane monitor screen","action":"omarchy-window-to-next-display"},
  "pane.stack": {"icon":"󰓩","label":"Next in Stack","description":"pane cycle","action":"omarchy-stack-cycle next"},
  "pane.newwindow": {"icon":"󰖯","label":"New Window","description":"pane","action":"omarchy-new-window"},
  "pane.close": {"icon":"󰅖","label":"Close Window","description":"pane quit","action":"hyprctl dispatch 'hl.dsp.window.close()'"},
  "app-firefox": {"icon":"󰈹","label":"Firefox"},
  "app-firefox.address": {"icon":"󰖟","label":"Address Bar","description":"url location go","action":"omarchy-send-shortcut CTRL L"},
  "app-firefox.back": {"icon":"󰁍","label":"Back","description":"history previous","action":"omarchy-send-shortcut ALT LEFT"},
  "app-firefox.forward": {"icon":"󰁔","label":"Forward","description":"history next","action":"omarchy-send-shortcut ALT RIGHT"},
  "app-firefox.reload": {"icon":"󰑐","label":"Reload","description":"refresh","action":"omarchy-send-shortcut CTRL R"},
  "app-firefox.find": {"icon":"󰍉","label":"Find in Page","description":"search","action":"omarchy-send-shortcut CTRL F"},
  "app-firefox.console": {"icon":"󰆍","label":"Console","description":"devtools javascript","action":"omarchy-send-shortcut 'CTRL SHIFT' K"},
  "app-firefox.inspector": {"icon":"󰙨","label":"Inspector","description":"devtools elements","action":"omarchy-send-shortcut 'CTRL SHIFT' C"},
  "app-firefox.devtools": {"icon":"󰅩","label":"Developer Tools","description":"devtools","action":"omarchy-send-shortcut '' F12"},
  "app-firefox.history": {"icon":"󰋚","label":"History","action":"omarchy-send-shortcut 'CTRL SHIFT' H"},
  "app-firefox.bookmark": {"icon":"󰃃","label":"Bookmark Page","description":"save star","action":"omarchy-send-shortcut CTRL D"},
  "app-firefox.bookmarks": {"icon":"󰃀","label":"Bookmarks","description":"library","action":"omarchy-send-shortcut 'CTRL SHIFT' O"},
  "app-firefox.downloads": {"icon":"󰇚","label":"Downloads","action":"omarchy-send-shortcut 'CTRL SHIFT' Y"},
  "app-firefox.reader": {"icon":"󰂺","label":"Reader View","action":"omarchy-send-shortcut '' F9"},
  "app-firefox.private": {"icon":"󰗹","label":"Private Window","description":"incognito","action":"omarchy-send-shortcut 'CTRL SHIFT' P"},
  "app-firefox.extensions": {"icon":"󰏗","label":"Extensions","description":"add-ons","action":"omarchy-send-shortcut 'CTRL SHIFT' A"},
  "app-firefox.settings": {"icon":"󰒓","label":"Settings","description":"preferences","action":"firefox about:preferences"},
  "app-firefox.left": {"icon":"󰯌","label":"Left Half","description":"pane snap move","action":"omarchy-snap left"},
  "app-firefox.right": {"icon":"󰯋","label":"Right Half","description":"pane snap move","action":"omarchy-snap right"},
  "app-firefox.full": {"icon":"󰊓","label":"Full Screen","description":"pane maximize","action":"omarchy-snap full"},
  "app-firefox.display": {"icon":"󰍹","label":"Move to Other Display","description":"pane monitor screen","action":"omarchy-window-to-next-display"},
  "app-firefox.stack": {"icon":"󰓩","label":"Next in Stack","description":"pane cycle","action":"omarchy-stack-cycle next"},
  "app-firefox.newwindow": {"icon":"󰖯","label":"New Window","description":"pane","action":"omarchy-new-window"},
  "app-firefox.close": {"icon":"󰅖","label":"Close Window","description":"pane quit","action":"hyprctl dispatch 'hl.dsp.window.close()'"},
  "app-signal": {"icon":"󰭹","label":"Signal"},
  "app-signal.new": {"icon":"󰏫","label":"New Message","description":"compose conversation","action":"omarchy-send-shortcut CTRL N"},
  "app-signal.search": {"icon":"󰍉","label":"Search Chats","description":"find","action":"omarchy-send-shortcut CTRL F"},
  "app-signal.searchchat": {"icon":"󰈞","label":"Search in This Chat","description":"find","action":"omarchy-send-shortcut 'CTRL SHIFT' F"},
  "app-signal.next": {"icon":"󰁅","label":"Next Chat","description":"conversation down","action":"omarchy-send-shortcut ALT DOWN"},
  "app-signal.prev": {"icon":"󰁝","label":"Previous Chat","description":"conversation up","action":"omarchy-send-shortcut ALT UP"},
  "app-signal.unread": {"icon":"󰇮","label":"Next Unread Chat","action":"omarchy-send-shortcut 'ALT SHIFT' DOWN"},
  "app-signal.attach": {"icon":"󰁦","label":"Attach File","action":"omarchy-send-shortcut CTRL U"},
  "app-signal.emoji": {"icon":"󰞅","label":"Emoji","action":"omarchy-send-shortcut 'CTRL SHIFT' J"},
  "app-signal.media": {"icon":"󰉏","label":"All Media","description":"photos files","action":"omarchy-send-shortcut 'CTRL SHIFT' M"},
  "app-signal.archive": {"icon":"󰀼","label":"Archive Chat","action":"omarchy-send-shortcut 'CTRL SHIFT' A"},
  "app-signal.settings": {"icon":"󰒓","label":"Settings","description":"preferences","action":"omarchy-send-shortcut CTRL COMMA"},
  "app-signal.shortcuts": {"icon":"󰌌","label":"Keyboard Shortcuts","action":"omarchy-send-shortcut CTRL SLASH"},
  "app-signal.zoomin": {"icon":"󰐕","label":"Zoom In","description":"bigger text","action":"omarchy-send-shortcut CTRL EQUAL"},
  "app-signal.zoomout": {"icon":"󰍴","label":"Zoom Out","description":"smaller text","action":"omarchy-send-shortcut CTRL MINUS"},
  "app-signal.zoomreset": {"icon":"󰑐","label":"Actual Size","description":"zoom reset","action":"omarchy-send-shortcut CTRL 0"},
  "app-signal.left": {"icon":"󰯌","label":"Left Half","description":"pane snap move","action":"omarchy-snap left"},
  "app-signal.right": {"icon":"󰯋","label":"Right Half","description":"pane snap move","action":"omarchy-snap right"},
  "app-signal.full": {"icon":"󰊓","label":"Full Screen","description":"pane maximize","action":"omarchy-snap full"},
  "app-signal.display": {"icon":"󰍹","label":"Move to Other Display","description":"pane monitor screen","action":"omarchy-window-to-next-display"},
  "app-signal.stack": {"icon":"󰓩","label":"Next in Stack","description":"pane cycle","action":"omarchy-stack-cycle next"},
  "app-signal.newwindow": {"icon":"󰖯","label":"New Window","description":"pane","action":"omarchy-new-window"},
  "app-signal.close": {"icon":"󰅖","label":"Close Window","description":"pane quit","action":"hyprctl dispatch 'hl.dsp.window.close()'"},
}
