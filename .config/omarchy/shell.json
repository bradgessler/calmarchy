{
  "bar": {
    "background": "none",
    "layout": {
      "center": [],
      "centerBegin": [],
      "centerEnd": [],
      "left": [
        {
          "id": "bradgessler.menu"
        },
        {
          "id": "bradgessler.workspaces"
        }
      ],
      "right": [
        {
          "headless": true,
          "id": "bradgessler.tray"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        },
        {
          "format": "ddd MMM d  HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "tray": [
        {
          "alwaysShow": true,
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "cities": [
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            }
          ],
          "id": "omarchy.elsewhen"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "superwhisper.panel"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        }
      ]
    },
    "position": "top"
  },
  "cloneSourceRestores": [
    "bradgessler.menu"
  ],
  "disabledPlugins": [
    "omarchy.dock",
    "omarchy.menu"
  ],
  "dock": {
    "autohide": true,
    "pinned": [
      "org.gnome.Nautilus",
      "chromium",
      "foot",
      "X",
      "YouTube"
    ],
    "position": "bottom"
  },
  "idle": {
    "lock": 300,
    "screensaver": 0
  },
  "plugins": [
    {
      "id": "bradgessler.stacks"
    }
  ],
  "version": 1
}
