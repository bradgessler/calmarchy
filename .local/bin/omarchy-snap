#!/bin/bash
# Panels: every window lives in one of these frames on its monitor.
#   omarchy-snap <panel> [address]   put a window (default: the active one) in a panel
#   omarchy-snap --frame-of <address>  print the panel a window sits in, or nothing
# Panels: full left right top bottom tl tr bl br
gap=${OMARCHY_SNAP_GAP:-8}
tolerance=6

frame() { # frame <panel> <monitor-id> -> "x y w h"
  hyprctl -j monitors | jq -r --arg pos "$1" --argjson mid "$2" --argjson gap "$gap" '
    .[] | select(.id == $mid)
    | (.x + .reserved[0] + $gap) as $ax | (.y + .reserved[1] + $gap) as $ay
    | (.width / .scale - .reserved[0] - .reserved[2] - 2 * $gap) as $aw
    | (.height / .scale - .reserved[1] - .reserved[3] - 2 * $gap) as $ah
    | (($aw - $gap) / 2) as $cw | (($ah - $gap) / 2) as $ch
    | { full:   [$ax, $ay, $aw, $ah],
        left:   [$ax, $ay, $cw, $ah],            right:  [$ax + $cw + $gap, $ay, $cw, $ah],
        top:    [$ax, $ay, $aw, $ch],            bottom: [$ax, $ay + $ch + $gap, $aw, $ch],
        tl:     [$ax, $ay, $cw, $ch],            tr:     [$ax + $cw + $gap, $ay, $cw, $ch],
        bl:     [$ax, $ay + $ch + $gap, $cw, $ch], br:   [$ax + $cw + $gap, $ay + $ch + $gap, $cw, $ch]
      }[$pos] // empty | map(floor) | join(" ")'
}

if [[ $1 == --frame-of ]]; then
  win=$(hyprctl -j clients | jq -c --arg a "$2" '.[] | select(.address == $a)')
  [[ -n $win ]] || exit 1
  read -r mid x y w h < <(jq -r '"\(.monitor) \(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"' <<<"$win")
  for p in full left right top bottom tl tr bl br; do
    read -r fx fy fw fh < <(frame "$p" "$mid")
    if (( ${x#-}-fx <= tolerance && fx-x <= tolerance && y-fy <= tolerance && fy-y <= tolerance \
       && w-fw <= tolerance && fw-w <= tolerance && h-fh <= tolerance && fh-h <= tolerance )); then
      echo "$p"; exit 0
    fi
  done
  exit 1
fi

pos=${1:?usage: omarchy-snap <full|left|right|top|bottom|tl|tr|bl|br> [address]}
if [[ -n $2 ]]; then
  win=$(hyprctl -j clients | jq -c --arg a "$2" '.[] | select(.address == $a)')
else
  win=$(hyprctl -j activewindow)
fi
addr=$(jq -r '.address // empty' <<<"$win")
[[ -n $addr ]] || exit 0
mid=$(jq -r '.monitor' <<<"$win")
read -r x y w h < <(frame "$pos" "$mid")
[[ -n $w ]] || { echo "omarchy-snap: unknown panel '$pos'" >&2; exit 2; }

target="window = \"address:$addr\""
cmds=()
[[ $(jq -r '.fullscreen' <<<"$win") != 0 ]] && cmds+=("dispatch hl.dsp.window.fullscreen({ action = \"unset\", $target })")
[[ $(jq -r '.floating' <<<"$win") == false ]] && cmds+=("dispatch hl.dsp.window.float({ action = \"enable\", $target })")
cmds+=("dispatch hl.dsp.window.resize({ x = $w, y = $h, exact = true, $target })")
cmds+=("dispatch hl.dsp.window.move({ x = $x, y = $y, relative = false, $target })")
IFS=';'; hyprctl --batch "${cmds[*]}" >/dev/null
