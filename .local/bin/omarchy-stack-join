#!/bin/bash
# After dragging a window: if it was dropped mostly on top of another window,
# snap it to that window's exact frame so the two form a stack in that pane.
active=$(hyprctl -j activewindow)
[[ $(jq -r '.address // empty' <<<"$active") ]] || exit 0
[[ $(jq -r '.floating' <<<"$active") == true ]] || exit 0
read -r x y w h < <(hyprctl -j clients | jq -r --argjson a "$active" '
  ($a.at) as $at | ($a.size) as $s
  | [ .[]
      | select(.mapped and .address != $a.address and .workspace.id == $a.workspace.id and (.hidden | not))
      | . as $w
      | ([$at[0], $w.at[0]] | max) as $x1 | ([$at[0]+$s[0], $w.at[0]+$w.size[0]] | min) as $x2
      | ([$at[1], $w.at[1]] | max) as $y1 | ([$at[1]+$s[1], $w.at[1]+$w.size[1]] | min) as $y2
      | (if $x2 > $x1 and $y2 > $y1 then ($x2-$x1)*($y2-$y1) else 0 end) as $inter
      | ([$s[0]*$s[1], $w.size[0]*$w.size[1]] | min) as $smaller
      | select($smaller > 0) | {ratio: ($inter / $smaller), w: $w} ]
  | sort_by(-.ratio) | .[0] // empty
  | select(.ratio >= 0.4)
  | "\(.w.at[0]) \(.w.at[1]) \(.w.size[0]) \(.w.size[1])"')
[[ -n $w ]] || exit 0
hyprctl --batch "dispatch hl.dsp.window.resize({ x = $w, y = $h, exact = true }); dispatch hl.dsp.window.move({ x = $x, y = $y, relative = false })" >/dev/null
