#!/bin/bash
# Spotlight's app rows: if the app already has a window, bring its most recent
# one forward (switching workspace or display as needed) and exit 0; otherwise
# exit 1 so the caller launches it.
#   omarchy-focus-app <desktop-id>     e.g. firefox, org.gnome.Nautilus
# Web-app launchers (an Exec with a URL, like X or the Claude accounts) always
# exit 1: their window class is the browser's, and they mean "open this page".
id=${1:?usage: omarchy-focus-app <desktop-id>}
id=${id%.desktop}

file=""
IFS=: read -ra dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for dir in "${dirs[@]}"; do
  [[ -f $dir/applications/$id.desktop ]] && { file=$dir/applications/$id.desktop; break; }
done

exec_line=""
wmclass=""
if [[ -n $file ]]; then
  exec_line=$(sed -n 's/^Exec=//p' "$file" | head -1)
  wmclass=$(sed -n 's/^StartupWMClass=//p' "$file" | head -1)
  [[ $exec_line == *://* ]] && exit 1
  if [[ $(sed -n 's/^Terminal=//p' "$file" | head -1) == true ]]; then
    # Omarchy runs terminal apps as org.omarchy.<command>.
    wmclass="org.omarchy.$(basename "$(awk '{print $1}' <<<"$exec_line")")"
  fi
fi
exe=$(basename "$(awk '{print $1}' <<<"$exec_line")" 2>/dev/null)

# Classes this app's windows might have: StartupWMClass, the desktop id, its
# last dotted part, and the executable name; compared without case.
addr=$(hyprctl -j clients | jq -r --arg a "$wmclass" --arg b "$id" --arg c "${id##*.}" --arg d "$exe" '
  ([$a, $b, $c, $d] | map(select(. != "") | ascii_downcase)) as $want
  | [ .[] | select(.mapped and .workspace.id > 0 and ((.class | ascii_downcase) as $k | $want | index($k))) ]
  | sort_by(.focusHistoryID) | .[0].address // empty')
[[ -n $addr ]] || exit 1

hyprctl --batch "dispatch hl.dsp.focus({ window = \"address:$addr\" }); dispatch hl.dsp.window.bring_to_top()" >/dev/null
exit 0
