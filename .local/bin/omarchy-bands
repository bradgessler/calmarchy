#!/bin/bash
# The black bands above and below the wallpaper: the top bar and the bottom
# letterbox band (where stack dots live).
#   omarchy-bands black|clear|toggle   set them   (no argument: print the mode)
# Clear shows the wallpaper through both (the notch shows too); the bottom band
# still reserves its height, and the dots get a soft pill so they stay legible.
file=~/.config/omarchy/bands
current=$(cat "$file" 2>/dev/null); [[ $current == clear ]] || current=black
case ${1:-} in
  "") echo "$current"; exit ;;
  toggle) [[ $current == clear ]] && mode=black || mode=clear ;;
  black|clear) mode=$1 ;;
  *) echo "usage: omarchy-bands [black|clear|toggle]" >&2; exit 2 ;;
esac
# Remember which panel each window is in; the frames are about to change.
memo=$(hyprctl -j clients | jq -r '.[] | select(.workspace.id > 0 and .mapped) | .address' |
  while read -r a; do p=$(omarchy-snap --frame-of "$a") && echo "$a $p"; done)

echo "$mode" >"$file"
# Black: a 32pt bar (notch) / 26pt elsewhere, then the 12pt gap. Clear: the bar
# is all there is above the windows (no gap): 6pt above its 11.5pt contents and
# 6pt below where there's no notch (24), and the notch's own 32 on the laptop,
# since windows can't start under the notch.
tpl=$HOME/.config/omarchy/themed/shell.toml.tpl
if [[ $mode == clear ]]; then notch=32 size=24; else notch=32 size=26; fi
sed -i -E "s/^(notch-height +=) *[0-9]+/\1 $notch/; s/^(size-horizontal +=) *[0-9]+/\1 $size/" "$tpl"
omarchy-theme-refresh >/dev/null 2>&1
[[ $mode == clear ]] && omarchy-bar background none >/dev/null || omarchy-bar background opaque >/dev/null

# Wait for the bar's new height to land, then put every window back in its panel.
for _ in $(seq 1 40); do
  [[ $(hyprctl -j monitors | jq -r --argjson n "$notch" --argjson s "$size" 'all(.[]; .reserved[1] == $n or .reserved[1] == $s)') == true ]] && break
  sleep 0.25
done
while read -r a p; do [[ -n $a ]] && omarchy-snap "$p" "$a"; done <<<"$memo"
