#!/bin/bash
# Run when a Super+drag ends: windows only live in panels, so land the dragged
# window in one (a torn-out, non-pane-sized window just stays where it's dropped).
# Dropped mostly onto another window, it joins that stack;
# released near the top edge, it goes full; otherwise it takes the left or
# right half under the pointer. Carried to another display, it keeps its panel.
win=$(hyprctl -j activewindow)
addr=$(jq -r '.address // empty' <<<"$win")
[[ -n $addr && $(jq -r '.floating' <<<"$win") == true ]] || exit 0
jq -e '(.tags // []) | any(startswith("omarchy-mode-opened"))' <<<"$win" >/dev/null || exit 0

# A torn-out window (resized out of its pane, so no pane has its size) moves
# freely: it stays where it's dropped. Dragging keeps a window's size, so a
# pane-sized window was in a pane and still snaps into one.
read -r ww wh < <(jq -r '"\(.size[0]) \(.size[1])"' <<<"$win")
mid=$(jq -r '.monitor' <<<"$win")
paned=0
for p in full left right top bottom tl tr bl br; do
  read -r _ _ fw fh < <(omarchy-snap --frame-on "$p" "$mid")
  if (( ww - fw <= 6 && fw - ww <= 6 && wh - fh <= 6 && fh - wh <= 6 )); then paned=1; break; fi
done
(( paned )) || exit 0

other=$(hyprctl -j clients | jq -r --argjson a "$win" '
  ($a.at) as $at | ($a.size) as $s
  | [ .[]
      | select(.mapped and .address != $a.address and .workspace.id == $a.workspace.id and (.hidden | not))
      | . as $w
      | ([$at[0], $w.at[0]] | max) as $x1 | ([$at[0]+$s[0], $w.at[0]+$w.size[0]] | min) as $x2
      | ([$at[1], $w.at[1]] | max) as $y1 | ([$at[1]+$s[1], $w.at[1]+$w.size[1]] | min) as $y2
      | (if $x2 > $x1 and $y2 > $y1 then ($x2-$x1)*($y2-$y1) else 0 end) as $inter
      | ([$s[0]*$s[1], $w.size[0]*$w.size[1]] | min) as $smaller
      | select($smaller > 0) | {ratio: ($inter / $smaller), addr: $w.address} ]
  | sort_by(-.ratio) | .[0] // empty | select(.ratio >= 0.4) | .addr')
if [[ -n $other ]]; then
  panel=$(omarchy-snap --frame-of "$other")
  [[ -n $panel ]] && { omarchy-snap "$panel" "$addr"; exit 0; }
fi

# Carried to another display, it keeps its panel: full stays full, a left half
# lands in the left half.
read -r last_panel last_mid < <(omarchy-snap --last "$addr")
if [[ -n $last_panel && $last_mid != "$(jq -r '.monitor' <<<"$win")" ]]; then
  omarchy-snap "$last_panel" "$addr"; exit 0
fi

read -r cx cy < <(hyprctl cursorpos | tr -d ',')
read -r mx my mw mh < <(hyprctl -j monitors | jq -r --argjson id "$(jq '.monitor' <<<"$win")" \
  '.[] | select(.id == $id) | "\(.x) \(.y) \(.width / .scale | floor) \(.height / .scale | floor)"')
if (( cy - my < mh / 8 )); then
  omarchy-snap full "$addr"
elif (( cx - mx < mw / 2 )); then
  omarchy-snap left "$addr"
else
  omarchy-snap right "$addr"
fi
