#!/bin/bash
# Cmd+N: open a new window of whatever app is focused. omarchy-panel-place puts
# it on top of the focused window's stack as it opens.
# With --full (Cmd+Shift+N) the new window fills the workspace instead.
# With --stack (Cmd+T in Firefox) it always goes on the focused window's stack,
# even when an empty half is free.
# Aim the panel-open rule at the focused window's frame right now, rather than
# trusting it to have kept up with focus changes.
hyprctl eval "panel_open_sync()" >/dev/null 2>&1
if [[ $1 == --stack ]]; then
  read -r x y w h < <(hyprctl -j activewindow | jq -r '"\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"')
  read -r mx my < <(hyprctl -j monitors | jq -r --argjson id "$(hyprctl -j activewindow | jq '.monitor')" '.[] | select(.id == $id) | "\(.x) \(.y)"')
  if [[ -n $w && $w != null ]]; then
    touch "${XDG_RUNTIME_DIR:-/tmp}/omarchy-place-stack"
    hyprctl eval "hl.window_rule({ name = \"panel-open\", enabled = true, match = { tag = \"omarchy-mode-opened\" }, size = \"$w $h\", move = \"$((x - mx)) $((y - my))\" })" >/dev/null
  fi
fi
if [[ $1 == --full ]]; then
  read -r x y w h < <(omarchy-snap --frame full)
  if [[ -n $w ]]; then
    touch "${XDG_RUNTIME_DIR:-/tmp}/omarchy-place-full"
    hyprctl eval "hl.window_rule({ name = \"panel-open\", enabled = true, match = { tag = \"omarchy-mode-opened\" }, size = \"$w $h\", move = \"$x $y\" })" >/dev/null
  fi
fi
win=$(hyprctl -j activewindow)
class=$(jq -r '.class // empty' <<<"$win")
pid=$(jq -r '.pid // empty' <<<"$win")

start() { setsid "$@" >/dev/null 2>&1 < /dev/null & }

case "$class" in
  "")
    start omarchy-launch-terminal ;;
  # Terminals (and Omarchy's agent console, which runs in one): a new terminal
  # in the same directory.
  foot|footclient|Alacritty|kitty|com.mitchellh.ghostty|org.omarchy.*|TUI.*)
    start omarchy-launch-terminal --pid="$pid" ;;
  firefox)
    start uwsm-app -- firefox --new-window ;;
  firefox-webapp-*)
    start omarchy-firefox-webapp "https://${class#firefox-webapp-}/" ;;
  chromium|chrome-*)
    start uwsm-app -- chromium --new-window ;;
  org.gnome.Nautilus)
    start uwsm-app -- nautilus --new-window ;;
  *)
    # Relaunch its desktop entry, which opens a new window for most apps, or
    # start the same program again.
    entry=""
    for dir in ~/.local/share/applications /usr/share/applications; do
      for f in "$dir/$class.desktop" "$dir/${class,,}.desktop"; do
        [[ -z $entry && -f $f ]] && entry=$(basename "$f" .desktop)
      done
      if [[ -z $entry ]]; then
        f=$(grep -lis "^StartupWMClass=$class\$" "$dir"/*.desktop 2>/dev/null | head -1)
        [[ -n $f ]] && entry=$(basename "$f" .desktop)
      fi
    done
    if [[ -n $entry ]]; then
      start uwsm-app -- gtk-launch "$entry"
    else
      exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null)
      [[ -x $exe ]] && start uwsm-app -- "$exe"
    fi
    ;;
esac
