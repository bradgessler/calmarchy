#!/bin/bash
# Cmd+N: open a new window of whatever app is focused. omarchy-panel-place puts
# it on top of the focused window's stack as it opens.
win=$(hyprctl -j activewindow)
class=$(jq -r '.class // empty' <<<"$win")
pid=$(jq -r '.pid // empty' <<<"$win")

start() { setsid "$@" >/dev/null 2>&1 < /dev/null & }

case "$class" in
  "")
    start omarchy-launch-terminal ;;
  # Terminals (and Omarchy's agent console, which runs in one): a new terminal
  # in the same directory.
  foot|footclient|Alacritty|kitty|com.mitchellh.ghostty|org.omarchy.*|TUI.*)
    start omarchy-launch-terminal --pid="$pid" ;;
  firefox)
    start uwsm-app -- firefox --new-window ;;
  firefox-webapp-*)
    start omarchy-firefox-webapp "https://${class#firefox-webapp-}/" ;;
  chromium|chrome-*)
    start uwsm-app -- chromium --new-window ;;
  org.gnome.Nautilus)
    start uwsm-app -- nautilus --new-window ;;
  *)
    # Relaunch its desktop entry, which opens a new window for most apps, or
    # start the same program again.
    entry=""
    for dir in ~/.local/share/applications /usr/share/applications; do
      for f in "$dir/$class.desktop" "$dir/${class,,}.desktop"; do
        [[ -z $entry && -f $f ]] && entry=$(basename "$f" .desktop)
      done
      if [[ -z $entry ]]; then
        f=$(grep -lis "^StartupWMClass=$class\$" "$dir"/*.desktop 2>/dev/null | head -1)
        [[ -n $f ]] && entry=$(basename "$f" .desktop)
      fi
    done
    if [[ -n $entry ]]; then
      start uwsm-app -- gtk-launch "$entry"
    else
      exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null)
      [[ -x $exe ]] && start uwsm-app -- "$exe"
    fi
    ;;
esac
